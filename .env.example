# Copy to .env and fill in your values. Never commit .env.

# Required for live chat (optional when MOCK_LLM=1)
OPENAI_API_KEY=your_openrouter_or_openai_key_here

# OpenRouter (default). Use https://api.openai.com/v1 for OpenAI directly.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Inexpensive default; change to any model your provider supports
MODEL=openai/gpt-4o-mini

# Set to 1 for offline demo and automated tests (no API calls)
MOCK_LLM=0
